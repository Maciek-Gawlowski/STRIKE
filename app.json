{
  "expo": {
    "name": "STRIKE",
    "slug": "strike",
    "scheme": "strike",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/logo.png",
    "backgroundColor": "#0D1B2A",
    "splash": {
      "backgroundColor": "#0D1B2A"
    },
    "ios": {
      "bundleIdentifier": "com.strikeangler.app",
      "buildNumber": "19",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "STRIKE uses your position to draw the fishing route and tag contacts, lost fish, and catches.",
        "NSPhotoLibraryUsageDescription": "STRIKE lets you attach catch photos to your trip log.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-image-picker",
      "expo-asset",
      "expo-sqlite",
      "expo-font",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "5dfd2ff0-ae12-4767-b6f0-f9e96466dde2"
      },
      "router": {}
    }
  }
}
